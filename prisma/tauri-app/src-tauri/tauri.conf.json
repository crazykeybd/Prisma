{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prisma",
  "version": "0.1.0",
  "identifier": "com.prisma.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Prisma 多软件自动化测试平台",
        "width": 920,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
